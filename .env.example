APP_NAME=Kronos Inventory Control API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://root:CAMBIAR_PASSWORD@localhost:3306/kronos_inventory?charset=utf8mb4

# Genera la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# No la compartas ni la subas a Git.
JWT_SECRET_KEY=PEGA_AQUI_LA_CLAVE_GENERADA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_INACTIVITY_MINUTES=30

# Frontends autorizados (CORS), separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Recuperación de contraseña (opcional) ---
# Sin SMTP_HOST el enlace de recuperación se imprime en la consola del backend.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
