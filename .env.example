APP_NAME=Kronos Inventory Control API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://root:CAMBIAR_PASSWORD@localhost:3306/kronos_inventory?charset=utf8mb4

# Genera la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# No la compartas ni la subas a Git.
JWT_SECRET_KEY=PEGA_AQUI_LA_CLAVE_GENERADA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_INACTIVITY_MINUTES=30

# Frontends autorizados (CORS), separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Correo saliente (código de recuperación y cambio de correo) ---
# Sin SMTP_HOST y con DEBUG=true, el código se imprime en la consola del backend.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tucuenta@gmail.com y
# SMTP_PASSWORD = "contraseña de aplicación" de 16 letras (requiere verificación
# en 2 pasos: https://myaccount.google.com/apppasswords). No uses tu clave normal.
# Puerto 465 = SSL directo; cualquier otro (587) = STARTTLS.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kronosinventorycontrol@gmail.com
SMTP_PASSWORD=
SMTP_FROM=kronosinventorycontrol@gmail.com
SMTP_FROM_NAME=Kronos Inventory
